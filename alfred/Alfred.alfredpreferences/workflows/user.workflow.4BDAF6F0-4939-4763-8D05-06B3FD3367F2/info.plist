				<string>#!/bin/bash

query=$(pbpaste)

if [[ -z "$query" ]]; then
    exit 0
fi

full_prompt="Traduci in italiano il seguente testo: $query"

echo "$full_prompt" | pbcopy


osascript &lt;&lt;'EOF'
tell application "Safari"
    activate
    
    set foundTab to false
    
    repeat with w in windows
        repeat with t in tabs of w
            if URL of t contains "chatgpt.com" then
                set current tab of w to t
                set index of w to 1
                set foundTab to true
                exit repeat
            end if
        end repeat
        
        if foundTab then exit repeat
    end repeat
    
    if not foundTab then
        make new document with properties {URL:"https://chatgpt.com"}
        delay 3
    end if
end tell


tell application "System Events"
    delay 1
    
    tell process "Safari"
        keystroke "v" using command down
        delay 0.2
        key code 36
    end tell
end tell
